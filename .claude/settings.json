{
  "model": "",
  "thinking": "off",
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Bash(go *)",
      "Bash(make *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(ln *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(timeout *)",
      "Bash(sort *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(gitcommit *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:golang.org)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)"
    ]
  },
  "preferences": {
    "auto_commit": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); if [ -n \"$f\" ] && grep -qi 'anthropic\\|claude' \"$f\" 2>/dev/null; then echo 'Error: File contains vendor names (Anthropic/Claude)' >&2; exit 1; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.go) gofmt -l \"$f\" 2>/dev/null | grep -q . && { echo 'Error: Go file would not be formatted' >&2; exit 1; } || exit 0 ;; *) exit 0 ;; esac"
          }
        ]
      }
    ]
  },
  "env": {
    "CGO_ENABLED": "0"
  }
}
