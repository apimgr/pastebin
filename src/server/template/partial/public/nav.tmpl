{{define "navlinklist"}}
    <a href="{{.AssetPrefix}}/" class="nav-link{{if eq .CurrentPath (print .AssetPrefix "/")}} active{{end}}">{{t .Lang "nav.home"}}</a>
    <a href="{{.AssetPrefix}}/create" class="nav-link{{if eq .CurrentPath (print .AssetPrefix "/create")}} active{{end}}">{{t .Lang "nav.create"}}</a>
    <a href="{{.AssetPrefix}}/recent" class="nav-link{{if eq .CurrentPath (print .AssetPrefix "/recent")}} active{{end}}">{{t .Lang "nav.recent"}}</a>
{{end}}
{{define "nav"}}
    <input type="checkbox" id="nav-toggle" class="nav-checkbox" hidden>

    <nav class="nav-links" aria-label="{{t .Lang "nav.main_navigation"}}">
        {{template "navlinklist" .}}
    </nav>

    <label for="nav-toggle" class="nav-toggle" aria-label="{{t .Lang "nav.toggle_menu"}}">☰</label>

    <div class="nav-panel">
        <label for="nav-toggle" class="nav-close" aria-label="{{t .Lang "nav.close_menu"}}">✕</label>
        {{template "navlinklist" .}}
    </div>
    <label for="nav-toggle" class="nav-overlay"></label>

    <div class="header-actions">
        {{if .HasOwnerToken}}
        <div class="dropdown">
            <button type="button" class="dropdown-toggle header-link" aria-label="{{t .Lang "nav.preferences_and_resources"}}" aria-haspopup="true">
                <span class="icon-preferences" aria-hidden="true">⚙️</span>
            </button>
            <div class="dropdown-menu">
                <a href="{{.OwnedResourceURL}}" class="dropdown-item" role="menuitem">{{t .Lang "nav.manage_my_paste"}}</a>
                <div class="dropdown-divider" role="separator"></div>
                <a href="{{.AssetPrefix}}/server/preferences" class="dropdown-item" role="menuitem">{{t .Lang "common.preferences"}}</a>
            </div>
        </div>
        {{else}}
        <a href="{{.AssetPrefix}}/server/preferences" class="header-link" aria-label="{{t .Lang "common.preferences"}}" title="{{t .Lang "common.preferences"}}">
            <span class="icon-preferences" aria-hidden="true">⚙️</span>
        </a>
        {{end}}
        <form class="theme-toggle theme-toggle-form" method="post" action="{{.AssetPrefix}}/theme">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="theme" value="{{.NextTheme}}">
            <button type="submit" class="theme-button" data-theme-toggle aria-label="{{t .Lang "theme.toggle"}} ({{t .Lang "common.currently"}} {{.Theme}})" title="{{t .Lang "theme.toggle"}}">
                {{if eq .Theme "dark"}}<span class="icon-dark" aria-hidden="true">🌙</span>{{else if eq .Theme "light"}}<span class="icon-light" aria-hidden="true">☀️</span>{{else}}<span class="icon-auto" aria-hidden="true">🌗</span>{{end}}
            </button>
        </form>
    </div>
{{end}}
