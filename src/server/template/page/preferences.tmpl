{{define "meta"}}
    <title>{{t .Lang "preferences.title"}} - {{.SiteTitle}}</title>
    <meta name="description" content="{{t .Lang "preferences.description"}}">
{{end}}

{{define "content"}}
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "preferences.title"}}</h1>
                </div>

                <div class="paste-view page-view">
                    <p>{{t .Lang "preferences.intro"}}</p>
                    <p class="alert">
                        <strong>{{t .Lang "preferences.current"}}:</strong>
                        {{t .Lang "preferences.theme_label"}} = {{t .Lang (print "theme." .PrefTheme)}},
                        {{t .Lang "preferences.lang_label"}} = {{t .Lang (print "lang." .PrefLang)}}
                    </p>

                    <h2 class="section-mt">{{t .Lang "preferences.theme_label"}}</h2>
                    <p>{{t .Lang "preferences.theme_desc"}}</p>
                    <div class="pref-options" role="group" aria-label="{{t .Lang "preferences.theme_label"}}">
                        {{range $mode := (slice "dark" "light" "auto")}}
                        <form method="post" action="{{$.AssetPrefix}}/server/preferences" class="pref-option-form">
                            <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                            <input type="hidden" name="theme" value="{{$mode}}">
                            <button type="submit" class="btn {{if eq $.PrefTheme $mode}}btn-primary{{else}}btn-secondary{{end}}"
                                    aria-pressed="{{if eq $.PrefTheme $mode}}true{{else}}false{{end}}"
                                    data-action="submit-loading" data-loading-text="{{t $.Lang "js.saving"}}">{{t $.Lang (print "theme." $mode)}}</button>
                        </form>
                        {{end}}
                    </div>

                    <h2 class="section-mt">{{t .Lang "preferences.lang_label"}}</h2>
                    <p>{{t .Lang "preferences.lang_desc"}}</p>
                    <div class="pref-options" role="group" aria-label="{{t .Lang "preferences.lang_label"}}">
                        {{range $code := (slice "en" "es" "fr" "de" "zh" "ar" "ja")}}
                        <a href="{{$.AssetPrefix}}/server/preferences?lang={{$code}}"
                           class="btn {{if eq $.PrefLang $code}}btn-primary{{else}}btn-secondary{{end}}"
                           aria-pressed="{{if eq $.PrefLang $code}}true{{else}}false{{end}}">{{t $.Lang (print "lang." $code)}}</a>
                        {{end}}
                    </div>

                    <h2 class="section-mt">{{t .Lang "preferences.token_title"}}</h2>
                    <p>{{t .Lang "preferences.token_desc"}}</p>
                    <p><button type="button" class="btn btn-secondary" data-action="forget-token">{{t .Lang "paste.forget_token"}}</button></p>

                    <h2 class="section-mt">{{t .Lang "preferences.export_title"}}</h2>
                    <p>{{t .Lang "preferences.export_desc"}}</p>
                    {{if .ExportURL}}
                    <div class="form-group">
                        <label for="pref-export-url" class="form-label">{{t .Lang "preferences.export_url"}}</label>
                        <div class="copy-field">
                            <input type="text" id="pref-export-url" class="form-input long-string" value="{{.ExportURL}}" readonly
                                   aria-describedby="pref-export-url-error" aria-invalid="false">
                            <button type="button" class="copy-btn" data-copy="{{.ExportURL}}" aria-live="polite" aria-label="{{t .Lang "preferences.copy"}}">
                                <span class="copy-text">📋</span>
                            </button>
                        </div>
                        <span id="pref-export-url-error" class="field-error" role="alert" hidden></span>
                    </div>
                    <div class="form-group">
                        <label for="pref-export-code" class="form-label">{{t .Lang "preferences.export_code"}}</label>
                        <div class="copy-field">
                            <input type="text" id="pref-export-code" class="form-input long-string" value="{{.ExportCode}}" readonly
                                   aria-describedby="pref-export-code-error" aria-invalid="false">
                            <button type="button" class="copy-btn" data-copy="{{.ExportCode}}" aria-live="polite" aria-label="{{t .Lang "preferences.copy"}}">
                                <span class="copy-text">📋</span>
                            </button>
                        </div>
                        <span id="pref-export-code-error" class="field-error" role="alert" hidden></span>
                    </div>
                    {{else}}
                    <p><a href="{{.AssetPrefix}}/server/preferences/export" class="btn btn-secondary">{{t .Lang "preferences.export_action"}}</a></p>
                    {{end}}

                    <h2 class="section-mt">{{t .Lang "preferences.import_title"}}</h2>
                    <p>{{t .Lang "preferences.import_desc"}}</p>
                    <form method="get" action="{{.AssetPrefix}}/server/preferences/import" class="contact-form">
                        <div class="form-group">
                            <label for="pref-import-code" class="form-label">{{t .Lang "preferences.import_code"}}</label>
                            <input type="text" id="pref-import-code" name="code" class="form-input long-string"
                                   maxlength="500" placeholder="{{t .Lang "preferences.import_placeholder"}}"
                                   aria-describedby="pref-import-code-error" aria-invalid="false">
                            <span id="pref-import-code-error" class="field-error" role="alert" hidden></span>
                        </div>
                        <button type="submit" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.importing"}}">{{t .Lang "preferences.import_action"}}</button>
                    </form>

                    <h2 id="ccpa-opt-out" class="section-mt">{{t .Lang "privacy.ccpa_do_not_sell"}}</h2>
                    {{if .Privacy.IsCCPAApplicable}}
                        {{if .CCPAOptedOut}}
                        <p>{{t .Lang "privacy.ccpa_opted_out_full"}}</p>
                        <form method="POST" action="{{.AssetPrefix}}/server/privacy/ccpa">
                            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                            <input type="hidden" name="action" value="opt_in">
                            <button type="submit" class="btn btn-secondary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "privacy.ccpa_opt_back_in"}}</button>
                        </form>
                        {{else}}
                        <p>{{t .Lang "privacy.ccpa_intro"}}</p>
                        <form method="POST" action="{{.AssetPrefix}}/server/privacy/ccpa">
                            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                            <input type="hidden" name="action" value="opt_out">
                            <button type="submit" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "privacy.ccpa_do_not_sell"}}</button>
                        </form>
                        {{end}}
                    {{else}}
                    <p>{{t .Lang "privacy.ccpa_not_applicable"}}</p>
                    {{end}}

                    {{$c := consentInfo}}
                    <h2 class="section-mt">{{t .Lang "preferences.consent_title"}}</h2>
                    <p>{{t .Lang "preferences.consent_desc"}}</p>
                    <form method="post" action="{{.AssetPrefix}}/server/consent" class="contact-form">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <p class="cookie-category">
                            <label>
                                <input type="checkbox" checked disabled aria-describedby="pref-consent-essential">
                                <span id="pref-consent-essential">{{$c.Descriptions.Essential}}</span>
                            </label>
                        </p>
                        <p class="cookie-category">
                            <label>
                                <input type="checkbox" name="preferences" value="1"{{if .ConsentPreferences}} checked{{end}}
                                       aria-describedby="pref-consent-preferences">
                                <span id="pref-consent-preferences">{{$c.Descriptions.Preferences}}</span>
                            </label>
                        </p>
                        {{if $c.AnalyticsConfigured}}
                        <p class="cookie-category">
                            <label>
                                <input type="checkbox" name="analytics" value="1"{{if .ConsentAnalytics}} checked{{end}}
                                       aria-describedby="pref-consent-analytics">
                                <span id="pref-consent-analytics">{{$c.Descriptions.Analytics}}</span>
                            </label>
                        </p>
                        {{end}}
                        <button type="submit" name="choice" value="save" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "cookie_consent.save_preferences"}}</button>
                        <button type="submit" name="choice" value="decline" class="btn btn-secondary">{{t .Lang "cookie_consent.decline"}}</button>
                    </form>
                </div>
            </div>
        </section>
{{end}}
