{{define "meta"}}
    <title>Privacy - {{.SiteTitle}}</title>
    <meta name="description" content="Privacy policy for {{.SiteTitle}} — what we collect, how it is used, retention, and your rights">
{{end}}

{{define "content"}}
        <section class="search-section">
            <div class="container container-sm">
                <div class="section-header">
                    <h1 class="section-title">{{t .Lang "privacy.title"}}</h1>
                </div>

                <div class="paste-view page-view">
                    <section id="summary" class="privacy-summary">
                    <p class="privacy-summary">
                        {{if .Privacy.Data.Sold}}
                            <strong>{{t .Lang "privacy.data_may_be_sold"}}</strong>
                            {{t .Lang "privacy.see_sections_prefix"}} <a href="#ccpa-opt-out">"{{t .Lang "privacy.ccpa_do_not_sell"}}"</a> {{t .Lang "privacy.see_sections_suffix"}}
                        {{else}}
                            <strong>{{t .Lang "privacy.never_sell"}}</strong>
                            {{if .Privacy.Data.StoredOnServer}}{{t .Lang "privacy.stored_own_servers"}}{{end}}
                        {{end}}
                    </p>
                    </section>

                    <section id="data-collection">
                    <h2 class="section-mt">{{t .Lang "privacy.data_we_collect"}}</h2>
                    <div class="markdown-content">{{markdown .Privacy.Content.DataCollection}}</div>
                    </section>

                    <section id="data-usage">
                    <h2 class="section-mt">{{t .Lang "privacy.how_we_use"}}</h2>
                    <div class="markdown-content">{{markdown .Privacy.GetDataUsageContent}}</div>
                    </section>

                    <section id="data-security">
                    <h2 class="section-mt">{{t .Lang "privacy.how_we_protect"}}</h2>
                    <div class="markdown-content">{{markdown .Privacy.Content.DataSecurity}}</div>
                    </section>

                    <section id="data-retention">
                    <h2 class="section-mt">{{t .Lang "privacy.data_retention"}}</h2>
                    <p>{{.Privacy.Retention.Period}}</p>
                    </section>

                    <section id="your-rights">
                    <h2 class="section-mt">{{t .Lang "privacy.your_rights"}}</h2>
                    <ul class="feature-list">
                        <li>{{t .Lang "privacy.data_export_label"}} {{if .Privacy.Retention.ExportAvailable}}{{t .Lang "privacy.export_available"}}{{else}}{{t .Lang "privacy.export_not_available"}}{{end}}</li>
                        <li>{{t .Lang "privacy.account_deletion_label"}} {{if .Privacy.Retention.DeletionAvailable}}{{t .Lang "privacy.export_available"}}{{else}}{{t .Lang "privacy.export_not_available"}}{{end}}</li>
                    </ul>
                    </section>

                    <section id="data-storage">
                    {{if .Privacy.Data.Sharing}}
                    <h2 class="section-mt">{{t .Lang "privacy.when_shared"}}</h2>
                    <table class="data-table">
                        <thead>
                            <tr><th>{{t .Lang "privacy.table_condition"}}</th><th>{{t .Lang "privacy.table_when"}}</th><th>{{t .Lang "privacy.table_data"}}</th></tr>
                        </thead>
                        <tbody>
                            {{range .Privacy.Data.Sharing}}
                            <tr>
                                <td>{{.Condition}}</td>
                                <td>{{.When}}</td>
                                <td class="long-string">{{.Data}}</td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                    {{end}}
                    </section>

                    <section id="third-parties">
                    {{if .ThirdPartyServices}}
                    <h2 class="section-mt">{{t .Lang "privacy.third_party_services"}}</h2>
                    <table class="data-table">
                        <thead>
                            <tr><th>{{t .Lang "privacy.service"}}</th><th>{{t .Lang "privacy.purpose"}}</th><th>{{t .Lang "privacy.data_sent"}}</th><th>{{t .Lang "privacy.table_policy"}}</th></tr>
                        </thead>
                        <tbody>
                            {{range .ThirdPartyServices}}
                            <tr>
                                <td>{{.Name}}</td>
                                <td>{{.Purpose}}</td>
                                <td class="long-string">{{.DataSent}}</td>
                                <td>
                                    {{if .PolicyURL}}
                                        <a class="long-string" href="{{.PolicyURL}}" rel="noopener noreferrer nofollow" target="_blank">{{t .Lang "privacy.view_policy"}}</a>
                                    {{else}}—{{end}}
                                </td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                    {{else}}
                    <h2 class="section-mt">{{t .Lang "privacy.third_party_services"}}</h2>
                    <p>{{t .Lang "privacy.no_third_party"}}</p>
                    {{end}}
                    </section>

                    <section id="cookies">
                    <h2 class="section-mt">{{t .Lang "privacy.cookies_heading"}}</h2>
                    <ul class="feature-list">
                        <li><strong>{{t .Lang "privacy.essential_label"}}</strong> {{.Privacy.Cookies.Essential.Description}}</li>
                        <li><strong>{{t .Lang "privacy.preferences_label"}}</strong> {{.Privacy.Cookies.Preferences.Description}}</li>
                        {{if .Tracking.Enabled}}
                        <li><strong>{{tf .Lang "privacy.analytics_label" "type" .Tracking.TypeName}}</strong> {{.Privacy.GetAnalyticsDescription}}</li>
                        {{end}}
                    </ul>
                    {{if .Privacy.Consent.ShowPreferences}}
                    <p>
                        <button type="button" class="btn btn-secondary" data-cookie-preferences>{{.Privacy.Consent.PreferencesText}}</button>
                    </p>
                    {{end}}
                    </section>

                    <h2 id="ccpa-opt-out" class="section-mt">{{t .Lang "privacy.ccpa_do_not_sell"}}</h2>
                    {{if .Privacy.IsCCPAApplicable}}
                        {{if .CCPAOptedOut}}
                        <p>{{t .Lang "privacy.ccpa_opted_out_full"}}</p>
                        <form method="POST" action="{{.AssetPrefix}}/server/privacy/ccpa">
                            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                            <input type="hidden" name="action" value="opt_in">
                            <button type="submit" class="btn btn-secondary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "privacy.ccpa_opt_back_in"}}</button>
                        </form>
                        {{else}}
                        <p>{{t .Lang "privacy.ccpa_intro"}}</p>
                        <form method="POST" action="{{.AssetPrefix}}/server/privacy/ccpa">
                            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                            <input type="hidden" name="action" value="opt_out">
                            <button type="submit" class="btn btn-primary" data-action="submit-loading" data-loading-text="{{t .Lang "js.saving"}}">{{t .Lang "privacy.ccpa_do_not_sell"}}</button>
                        </form>
                        {{end}}
                    {{else}}
                    <p>{{t .Lang "privacy.ccpa_not_applicable"}}</p>
                    {{end}}

                    <section id="contact">
                    <h2 class="section-mt">{{t .Lang "privacy.contact_us"}}</h2>
                    <p>
                        {{t .Lang "privacy.contact_intro"}} <a href="{{.AssetPrefix}}/server/contact">{{t .Lang "privacy.contact_page_link"}}</a>.
                    </p>
                    </section>
                </div>
            </div>
        </section>
{{end}}
